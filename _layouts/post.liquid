---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<article class="container-post">
  <header class="post-title">
    <h1>{{ page.title }}</h1>
    <p class="post-byline">{{ page.date | date: '%Y-%m-%d' }}</p>
  </header>

  <div class="post-content" id="markdown-content">
    {{ content }}
  </div>

  <footer class="post-info">
    {% if page.categories and page.categories != empty %}
      <p>Categories: {{ page.categories | join: ' / ' }}</p>
    {% endif %}

    <nav class="post-other" aria-label="Adjacent posts">
      {% if page.previous %}
        <a class="ref_internal post-previous" href="{{ page.previous.url | relative_url }}">&larr; {{ page.previous.title }}</a>
      {% endif %}
      {% if page.next %}
        <a class="ref_internal post-next" href="{{ page.next.url | relative_url }}">{{ page.next.title }} &rarr;</a>
      {% endif %}
    </nav>
  </footer>
</article>
