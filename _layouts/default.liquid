<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/paper.css' | relative_url | bust_css_cache }}">
  </head>

  <body class="paper-page{% if page.cv_mode %} cv-page{% endif %}">
    <div class="container-wrapper">
      <header class="container-header{% if page.url == '/index.html' or page.url == '/cv/' %} container-header-minimal{% endif %}">
        <div class="header-info">
          <a class="header-info-name ref_internal" href="{{ '/' | relative_url }}">{{ site.title }}</a>
          <span class="header-info-desc">{{ site.description }}</span>
        </div>
        {% unless page.url == '/index.html' or page.url == '/cv/' %}
        <nav class="header-nav" aria-label="Primary navigation">
          <ul class="header-main-nav">
            <li class="header-main-nav-item">
              <a
                class="ref_internal{% if page.url == '/' or page.url == '/blog/' or page.layout == 'post' %} is-active{% endif %}"
                href="{{ '/' | relative_url }}"
              >
                Blog
              </a>
            </li>
            <li class="header-main-nav-item">
              <a
                class="ref_internal{% if page.url == '/cv/' %} is-active{% endif %}"
                href="{{ '/cv/' | relative_url }}"
              >
                CV
              </a>
            </li>
          </ul>
        </nav>
        {% endunless %}
      </header>

      <main class="container-main" id="main-content">
        {{ content }}
      </main>

      <footer class="container-footer">
        <div class="footer-copyright">
          <span class="footer-copyright-text float-left">Copyright &copy; {{ site.time | date: '%Y' }}. zhaode.wang.</span>
          <span class="footer-copyright-text float-right"> Powered by <a class="ref_internal" href="https://jekyllrb.com/">Jekyll</a>. </span>
        </div>
      </footer>
    </div>

    <script>
      function determineComputedTheme() {
        return 'light';
      }
    </script>
    {% include scripts.liquid %}
  </body>
</html>
