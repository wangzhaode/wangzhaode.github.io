---
layout: default
---
<div class="resume-shell">
  <div class="resume-toolbar" aria-label="CV actions">
    <button
      class="resume-language-option"
      type="button"
      data-cv-lang-toggle
      data-cv-label-en="中文"
      data-cv-label-zh="English"
      aria-label="Switch to Chinese CV"
    >
      中文
    </button>
    {% if page.cv_pdf %}
      <a
        class="resume-action"
        href="{{ page.cv_pdf | relative_url }}"
        data-cv-download
        data-cv-pdf-en="{{ page.cv_pdf | relative_url }}"
        data-cv-pdf-zh="{{ page.cv_pdf_zh | relative_url }}"
        download
      >
        <span data-cv-label-en="Download PDF" data-cv-label-zh="下载 PDF">Download PDF</span>
      </a>
    {% endif %}
  </div>

  {% include cv-content.liquid data=site.data.cv lang='en' html_lang='en' %}
  {% include cv-content.liquid data=site.data.cv_zh lang='zh' html_lang='zh-CN' hidden=true %}
</div>

<script src="{{ '/assets/js/cv-language.js' | relative_url }}" defer></script>
