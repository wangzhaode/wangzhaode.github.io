{% assign profile = site.data.repositories.github_profile %}

<div class="repo repo-profile p-2">
  <a class="repo-card repo-profile-card" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <span class="repo-profile-icon"><i class="fa-brands fa-github" aria-hidden="true"></i></span>
    <span class="repo-profile-content">
      <strong>{{ profile.name | default: include.username }}</strong>
      <span>@{{ include.username }}</span>
      {% if profile.bio %}<span class="repo-profile-bio">{{ profile.bio }}</span>{% endif %}
    </span>
    <span class="repo-profile-link">View GitHub <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
  </a>
</div>
