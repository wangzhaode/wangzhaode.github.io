{% assign repository = include.repository %}
{% assign repo_url = repository.name | split: '/' %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ repository.name }}" target="_blank" rel="noopener noreferrer">
    <span class="repo-card-header">
      <span class="repo-card-name">
        <i class="fa-brands fa-github" aria-hidden="true"></i>
        <span class="repo-card-owner">{{ repo_url[0] }}/</span><strong>{{ repo_url[1] }}</strong>
      </span>
      <i class="fa-solid fa-arrow-up-right-from-square repo-card-external" aria-hidden="true"></i>
    </span>

    <span class="repo-card-description">{{ repository.description }}</span>

    <span class="repo-card-meta">
      {% if repository.language %}
        <span>
          <span class="repo-language-dot" style="--repo-language-color: {{ repository.language_color }}"></span>
          {{ repository.language }}
        </span>
      {% endif %}
      {% if repository.stars %}
        <span><i class="fa-regular fa-star" aria-hidden="true"></i> {{ repository.stars }}</span>
      {% endif %}
      {% if repository.forks %}
        <span><i class="fa-solid fa-code-fork" aria-hidden="true"></i> {{ repository.forks }}</span>
      {% endif %}
    </span>
  </a>
</div>
